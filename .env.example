RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=you@example.com,second@example.com  # comma separated
# Must be on a domain verified in Resend
CONTACT_FROM_EMAIL=Wellthyfy Lifestyle Ventures <hello@info.wellthyfy.in>

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
NEXT_PUBLIC_UPI_ID=yourname@bank
NEXT_PUBLIC_UPI_PAYEE_NAME=Wellthyfy Lifestyle Ventures

# Public origin used for links inside emails (invitation links etc.).
# Leave unset in local development to use the request host.
NEXT_PUBLIC_SITE_URL=https://www.wellthyfy.in

# Shared secret for /api/cron/reminders (class reminder emails). Its SHA-256 is
# stored in public.cron_tokens; send it as "Authorization: Bearer <secret>".
CRON_SECRET=

# Razorpay Standard Checkout. The key id is handed to the browser by
# /api/razorpay/create-order; the secret never leaves the server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Shared secret for record_razorpay_payment(). Its SHA-256 is stored in
# public.cron_tokens (name 'payments') — see supabase/migrations/0009_razorpay.sql.
PAYMENTS_SECRET=
# Webhook secret you choose in Razorpay → Settings → Webhooks (event: order.paid,
# URL: https://<your-domain>/api/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=
